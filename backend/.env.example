# Sarvam Speech-to-Text API Configuration
SARVAM_API_KEY=your_sarvam_api_key_here

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_chunks

# Embedding & LLM Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Option A: NVIDIA Nemotron LLM (Recommended)
NVIDIA_API_KEY=your_nvidia_api_key_nvapi_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Option B: Generic / OpenAI / Gemini LLM
LLM_API_KEY=your_llm_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=

# API Server & CORS Configuration
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30

# Search & Retrieval Parameters
TOP_K=5
RERANK_TOP_K=20
